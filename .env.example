# =============================================================
# Variables del portfolio
#
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube: ya está en .gitignore.
#
# Las tres de aquí son PÚBLICAS por diseño: acaban dentro del
# JavaScript que descarga el navegador y se pueden ver. Están pensadas
# para eso. Los secretos de verdad (service_role, Turnstile secret,
# Resend) van en Supabase, no aquí.
# =============================================================

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile -> clave de SITIO (la pública)
# Si se deja vacía, el formulario funciona igual y queda solo el honeypot.
VITE_TURNSTILE_SITE_KEY=

# Cal.com -> tu usuario y el evento, por ejemplo: andreabohorquez/45min
# Si se deja vacía, no se muestra el bloque de agenda.
VITE_CAL_LINK=
