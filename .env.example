# Cloudflare Turnstile -> clave de SITIO (la pública)
#
# El valor de abajo es la clave de PRUEBA oficial de Cloudflare: siempre
# aprueba, en cualquier dominio, y sirve para desarrollar sin depender de
# que el widget real esté bien configurado.
#
# Para producción se cambia por la clave real del panel de Cloudflare, y
# en la Edge Function hay que poner la clave SECRETA que le corresponde.
#
# Otras claves de prueba de Cloudflare, por si hace falta:
#   1x00000000000000000000AA  siempre aprueba (visible)
#   2x00000000000000000000AB  siempre falla   (para probar el error)
#   3x00000000000000000000FF  fuerza el desafío interactivo
#
# Si se deja vacía, el formulario funciona igual y queda solo el honeypot.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cal.com -> tu usuario y el evento, por ejemplo: andreabohorquez/45min
# Si se deja vacía, no se muestra el bloque de agenda.
VITE_CAL_LINK=
